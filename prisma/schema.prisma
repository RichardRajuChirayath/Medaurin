generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String?
  username    String?      @unique
  avatarUrl   String?
  allergies   String[]     @default([])
  conditions  String[]     @default([])
  fcmToken    String?
  
  // Contact & Auth
  phoneNumber String?      @unique
  email       String?      @unique
  emailVerified DateTime?
  firebaseUid String?      @unique
  
  // SaaS Features
  notificationSettings Json?  @default("{\"email\":true,\"push\":true,\"marketing\":false}")
  medicineBudget Float? // Monthly medicine budget for alerts
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  analyses    Analysis[]
  dosageLogs  DosageLog[]
  favorites   Favorite[]
  medications Medication[]
  sessions    Session[]
  accounts    Account[]
  loginHistory LoginHistory[]
  expenses    MedicineExpense[]
  emailConfig EmailConfig?

  // Caregiver System
  caregivers  CareRelationship[] @relation("PatientToCaregiver")
  patients    CareRelationship[] @relation("CaregiverToPatient")
}

model CareRelationship {
  id          String   @id @default(cuid())
  caregiverId String
  patientId   String
  status      String   @default("PENDING") // PENDING, ACTIVE, REJECTED
  nickname    String?  // e.g., "Mom", "Grandpa"
  permissions Json?    @default("{\"view_logs\":true,\"receive_alerts\":true,\"remote_nudge\":true}")
  
  caregiver   User     @relation("CaregiverToPatient", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient     User     @relation("PatientToCaregiver", fields: [patientId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caregiverId, patientId])
  @@index([caregiverId])
  @@index([patientId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique // The actual JWT or session ID stored in cookie
  userId       String
  expires      DateTime
  
  // Device Tracking
  ipAddress    String?
  userAgent    String?
  device       String?  // Parsed device name e.g. "Chrome on Windows"
  location     String?
  
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  
  ipAddress String?
  userAgent String?
  device    String?
  location  String?
  
  status    String   // "SUCCESS", "FAILED", "SUSPICIOUS"
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String
  medicines       String[]
  status          String
  score           Int
  analysisType    String
  interactions    Json
  recommendations String[]
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Medication {
  id              String      @id @default(cuid())
  userId          String
  medicineName    String
  dosage          String
  frequency       String
  reminderTimes   String[]
  reminderEnabled Boolean     @default(true)
  startDate       DateTime    @default(now())
  endDate         DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  dosageLogs      DosageLog[]
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DosageLog {
  id            String     @id @default(cuid())
  userId        String
  medicationId  String
  takenAt       DateTime   @default(now())
  scheduledTime String
  status        String
  notes         String?
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([medicationId])
  @@index([takenAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  medicines String[]
  name      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MedicineExpense {
  id            String   @id @default(cuid())
  userId        String
  
  // Medicine Details
  medicineName  String
  quantity      String?  // e.g., "10 tablets", "1 bottle"
  price         Float
  category      String?  // e.g., "tablet", "syrup", "injection", "ointment"
  
  // Purchase Details
  purchaseDate  DateTime @default(now())
  pharmacyName  String?
  pharmacyLocation String? // For OSM intelligence
  
  // Import Source
  importSource  String   @default("manual") // "manual", "ocr", "email", "auto"
  invoiceUrl    String?  // Optional: link to uploaded invoice
  rawInvoiceText String? @db.Text // For future reference
  
  // India Government Verification (CDSCO/NPPA)
  govApprovalStatus String   @default("UNKNOWN") // APPROVED / BANNED / UNKNOWN
  isBanned          Boolean  @default(false)
  govMrp            Float?   // Government-approved MRP from NPPA
  isOverpriced      Boolean  @default(false)
  manufacturerName  String?
  manufacturerLicense String?
  verifiedAt        DateTime?
  verificationAlerts String[] @default([])
  
  // Optional
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purchaseDate])
  @@index([pharmacyName])
  @@index([isBanned])
  @@index([govApprovalStatus])
}

model EmailConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  
  // IMAP Settings
  email         String
  imapServer    String   // e.g., "imap.gmail.com"
  imapPort      Int      @default(993)
  
  // Encrypted App Password (AES-256)
  encryptedPassword String @db.Text
  
  // Auto-import settings
  autoImportEnabled Boolean @default(false)
  lastSyncedAt  DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
