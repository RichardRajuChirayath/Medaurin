# MixSafe Environment Configuration
# Copy this file to `.env.local` and fill in your values

# ============================================
# Required for Production
# ============================================

# Database URL for Prisma (PostgreSQL)
# Get one free from: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Optional - For Enhanced Features
# ============================================

# Google OAuth (optional - for social login)
# Get from: https://console.developers.google.com/
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# Production Overrides (set in Vercel)
# ============================================

# For production deployment:
# - Set NEXTAUTH_URL to your production domain
# - Use a strong NEXTAUTH_SECRET
# - DATABASE_URL should point to production database
