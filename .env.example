# Database
DATABASE_URL="postgresql://user:password@localhost:5432/medaurin?schema=public"

# Authentication
SESSION_SECRET="your-super-secret-session-key-min-32-characters-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-characters"

# Optional: Firebase Cloud Messaging (for push notifications)
# Get these from: https://console.firebase.google.com
# VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="your-client-email"
# FIREBASE_PRIVATE_KEY="your-private-key"

# Optional: Email Service (Brevo for magic links)
# Get API key from: https://www.brevo.com
# BREVO_API_KEY="your-brevo-api-key"

# Optional: Weather API (for Health Shield feature)
# Get free key from: https://openweathermap.org/api
# OPENWEATHER_API_KEY="your-openweather-api-key"

# Encryption (for sensitive data like email passwords)
ENCRYPTION_KEY="your-32-character-encryption-key-here-must-be-exactly-32-chars"
